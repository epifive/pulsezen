# ─────────────────────────────────────────────────────────────────────────────
# Pulsezen environment variables
#
# You do NOT need this file for a normal installation: open your site in the
# browser and the web installer writes everything to storage/config.json.
#
# Use these variables only for Docker, Vercel, the worker, read-only hosting or
# advanced setups. Copy this file to `.env.local` (or set the variables in your
# hosting panel). Values set by the hosting panel or PM2 win over .env files.
# ─────────────────────────────────────────────────────────────────────────────

# Port the server listens on (server.js / npm start). HOST sets the address for server.js
# (default 0.0.0.0).
PORT=3000
# HOST=0.0.0.0

# Public address of the platform, used when "Site URL" is empty in Admin → Settings → General.
# The tracking snippet (https://…/pz.js), dashboard links in alerts, email reports and the
# cron URL are built from it, so use your final https:// address.
# SITE_URL=https://analytics.example.com

# Where config.json, the SQLite database and uploads (logos) are stored.
# STORAGE_DIR=/var/lib/pulsezen

# Number of reverse proxies in front of the app that add X-Forwarded-For. Used to find the
# connecting IP for rate limits (sign-in, registration, cron URL, event endpoint).
# Default 1: Nginx, Apache/Passenger (cPanel) or Vercel. Use 2 for Cloudflare in front of Nginx.
# TRUSTED_PROXY_HOPS=1

# Database — overrides storage/config.json when set.
# Either one connection URL (cloud providers give you this)…
# DATABASE_URL=mysql://user:password@host:3306/pulsezen?ssl=true
# …or separate values:
# DB_DRIVER=mysql            # mysql or sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=pulsezen
# DB_USER=pulsezen
# DB_PASSWORD=secret
# DB_SSL=true                # required by TiDB Cloud, Aiven, DigitalOcean and most cloud MySQL
# DB_FILE=database.sqlite    # SQLite only, relative to STORAGE_DIR

# Create (or promote) an administrator without the web installer (password: 8+ characters).
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me-please
# ADMIN_NAME=Administrator

# Fill an empty database once with sample data for a live demo: customers, payments and
# messages, plus sample websites with analytics history for the first administrator.
# Needs ADMIN_EMAIL/ADMIN_PASSWORD. Runs once per database.
# DEMO_SEED=true

# Skip the web installer when the database is configured with the variables above
# (e.g. Vercel). Tables are created automatically; use ADMIN_* for the first administrator.
# APP_INSTALLED=true

# Keep Server Action ids stable across multiple servers / rebuilds (optional).
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Demo mode: the admin panel and the customer dashboard are read-only. Use this for a
# public live demo.
# DEMO_MODE=true

# Secret for the scheduler URL /api/cron/tick and for `npm run worker` (background jobs:
# daily summaries, data retention, traffic alerts, email reports, usage emails).
# Without it, one is generated, stored in the database and shown in Admin → System → Scheduler.
# Use at least 12 random characters (e.g. `openssl rand -hex 24`); shorter values and the
# example value "change-me-to-a-long-random-string" are ignored by the app.
# Vercel Cron sends it automatically as "Authorization: Bearer <CRON_SECRET>".
# ecosystem.config.cjs and docker-compose.yml need it in their environment for the worker.
# CRON_SECRET=a-long-random-string

# Worker only (npm run worker): address of the app (default SITE_URL, else
# http://localhost:$PORT) and seconds between ticks (default 15, minimum 5).
# WORKER_URL=http://localhost:3000
# WORKER_INTERVAL_SEC=15

# ── Event collection (POST /api/event) ──

# Events per minute per visitor IP and website (default 120).
# EVENT_RATE_LIMIT_PER_MIN=120
# Events per minute per connecting IP and website when the request arrives through a
# first-party proxy (the proxy sends for all its visitors; default 600). Both limits apply
# to proxied events. Kept moderate because X-Forwarded-For can be forged; raise it when a
# busy website sends more than ~10 events per second through its proxy.
# EVENT_PROXY_RATE_LIMIT_PER_MIN=600

# Write every event to the database right after each request instead of in batches every
# 2 seconds. Set automatically on Vercel, Netlify and AWS Lambda; set it yourself on other
# serverless or scale-to-zero hosts.
# PULSEZEN_SERVERLESS=1

# ── Alerts ──

# Allow webhook alert channels to post to private / internal addresses (localhost, 10.x,
# 192.168.x …), e.g. n8n on your own network. Only for single-company installations:
# on a public platform it would let customers reach your internal network.
# ALLOW_PRIVATE_WEBHOOKS=1

# ── Development only ──

# Build folder of Next.js (default .next). Lets a second development server run from the
# same folder, e.g. NEXT_DIST_DIR=.next-test. Don't set it in production.
# NEXT_DIST_DIR=.next
